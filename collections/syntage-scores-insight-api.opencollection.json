{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight Scores Insight API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Scores Insight",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get scores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/insights/metrics/scores",
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Entity scores aggregated from every configured score source (Syntage Score and any third-party rating providers enabled for the organization)."
        },
        {
          "info": {
            "name": "Get Syntage Score distribution",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/insights/metrics/scores/syntage/distribution"
          },
          "docs": "Get the distribution of current Syntage Score values across score buckets."
        },
        {
          "info": {
            "name": "Get Buró de Crédito summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/insights/metrics/buro-de-credito/summary",
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              },
              {
                "name": "options[from]",
                "value": "",
                "type": "query",
                "description": "Filter by report creation date on or after this date"
              },
              {
                "name": "options[to]",
                "value": "",
                "type": "query",
                "description": "Filter by report creation date on or before this date"
              }
            ]
          },
          "docs": "List Buró de Crédito report score summaries for an entity."
        },
        {
          "info": {
            "name": "Export Buró de Crédito summary",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/insights/metrics/buro-de-credito/summary/export",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              },
              {
                "name": "options[from]",
                "value": "",
                "type": "query",
                "description": "Filter by report creation date on or after this date"
              },
              {
                "name": "options[to]",
                "value": "",
                "type": "query",
                "description": "Filter by report creation date on or before this date"
              }
            ]
          },
          "docs": "Export Buró de Crédito report score summaries for an entity as CSV or XLSX."
        }
      ]
    }
  ],
  "bundled": true
}