{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight Insight Exports API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Insight Exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export an insight",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/insights/:insight/export",
            "headers": [
              {
                "name": "Accept",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              },
              {
                "name": "insight",
                "value": "sales-revenue",
                "type": "path",
                "description": "Insight name to export"
              }
            ]
          },
          "docs": "Export a supported insight for an entity as CSV or XLSX.\n\nUse the same `options[...]` query parameters supported by the corresponding insight endpoint. Unsupported insight names return `404`.\n"
        }
      ]
    }
  ],
  "bundled": true
}