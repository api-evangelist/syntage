                "name": "deactivatedAt[after]",
                "value": "2020-01-17 11:47:27",
                "type": "query",
                "description": "Filter by deactivation date (greater than or equal `>=`)"
              },
              {
                "name": "deactivatedAt[strictly_after]",
                "value": "2020-01-17 11:47:27",
                "type": "query",
                "description": "Filter by deactivation date (greater than `>`)"
              },
              {
                "name": "createdAt[before]",
                "value": "2020-01-17 11:47:27",
                "type": "query",
                "description": "Filter by resource creation date (less than or equal `<=`)"
              },
              {
                "name": "createdAt[strictly_before]",
                "value": "2020-01-17 11:47:27",
                "type": "query",
                "description": "Filter by resource creation date (less than `<`)"
              },
              {
                "name": "createdAt[after]",
                "value": "2020-01-17 11:47:27",
                "type": "query",
                "description": "Filter by resource creation date (greater than or equal `>=`)"
              },
              {
                "name": "createdAt[strictly_after]",
                "value": "2020-01-17 11:47:27",
                "type": "query",
                "description": "Filter by resource creation date (greater than `>`)"
              },
              {
                "name": "order[createdAt]",
                "value": "",
                "type": "query",
                "description": "Order by resource creation date"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Collection page number"
              },
              {
                "name": "itemsPerPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "List SAT credentials available to your organization.\n"
        },
        {
          "info": {
            "name": "Create a credential",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syntage.com/credentials",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a SAT credential for an RFC.\nIf the RFC is not already associated with your organization, Syntage creates the related entity association as part of credential creation.\n"
        },
        {
          "info": {
            "name": "Retrieve a credential",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/credentials/:id",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a SAT credential by ID, including its credential type, RFC, and validation status.\n"
        },
        {
          "info": {
            "name": "Delete a credential",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.syntage.com/credentials/:id",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Delete a SAT credential so it can no longer be used for new extraction work.\n"
        },
        {
          "info": {
            "name": "Revalidate a credential",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syntage.com/credentials/:id/revalidate",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Request validation for a SAT credential that is not already valid.\n"
        }
      ]
    }
  ],
  "bundled": true
