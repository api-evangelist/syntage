{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight DS MX RPC Actos API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DS MX RPC Actos",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve RPC acto",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/rpc/actos/:id",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve one RPC acto by ID, including registry act metadata, parsed act data, and file reference when a registry document is available."
        },
        {
          "info": {
            "name": "List an entity's RPC actos",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/datasources/mx/rpc/actos",
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              },
              {
                "name": "id[lt]",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "query",
                "description": "Collection cursor pointer to the next page"
              },
              {
                "name": "id[gt]",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "query",
                "description": "Collection cursor pointer to the previous page"
              },
              {
                "name": "itemsPerPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "rpcEntidade.lookupBy",
                "value": "",
                "type": "query",
                "description": "Filter by the lookup type of the related RPC entidade (exact match)"
              }
            ]
          },
          "docs": "List RPC actos extracted for an entity. Use this endpoint when your integration needs individual registry acts rather than the complete RPC entidade response."
        }
      ]
    }
  ],
  "bundled": true
}