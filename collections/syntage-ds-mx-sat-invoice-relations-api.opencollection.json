{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight DS MX SAT Invoice Relations API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "DS MX SAT Invoice Relations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve an invoice relation",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/invoices/relations/:id",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an invoice relation by ID, including the source invoice, related invoice, related invoice UUID, and SAT relation type.\n"
        },
        {
          "info": {
            "name": "List an invoice's relations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/invoices/:invoiceId/relations",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id[lt]",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "query",
                "description": "Collection cursor pointer to the next page"
              },
              {
                "name": "id[gt]",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "query",
                "description": "Collection cursor pointer to the previous page"
              },
              {
                "name": "itemsPerPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "List invoice relations for the requested invoice.\n"
        },
        {
          "info": {
            "name": "List an entity's invoice relations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/invoices/:invoiceId/relations",
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              },
              {
                "name": "id[lt]",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "query",
                "description": "Collection cursor pointer to the next page"
              },
              {
                "name": "id[gt]",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "query",
                "description": "Collection cursor pointer to the previous page"
              },
              {
                "name": "itemsPerPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "List invoice relations for an invoice within an entity.\n"
        }
      ]
    }
  ],
  "bundled": true
}