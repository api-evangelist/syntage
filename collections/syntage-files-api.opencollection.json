{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight Files API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/files/:id",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve file metadata, including type, filename, media type, size, and the resource associated with the file."
        },
        {
          "info": {
            "name": "Download content",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/files/:id/download",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "The response includes the `Location` header with the URL to download the file (make sure to follow the redirection)."
        }
      ]
    }
  ],
  "bundled": true
}