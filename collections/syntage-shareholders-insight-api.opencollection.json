{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight Shareholders Insight API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shareholders Insight",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get shareholders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/entities/:entityId/insights/shareholders",
            "params": [
              {
                "name": "entityId",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              },
              {
                "name": "relations.relationType",
                "value": "shareholders",
                "type": "query",
                "description": "Shareholder relation direction to return"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for pagination"
              },
              {
                "name": "itemsPerPage",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              }
            ]
          },
          "docs": "Returns a paginated shareholder insight for an entity.\n\nUse `relations.relationType=shareholders` to list the entity's shareholders. Use `relations.relationType=shareholder_of` to list entities that this shareholder owns shares in.\n\nWhen `relations.relationType=shareholders` and Company Verification-sourced shareholder data is available, the response returns Company Verification-sourced shareholders instead of older RPC-sourced rows. If no Company Verification-sourced shareholders are available,"
        }
      ]
    }
  ],
  "bundled": true
}