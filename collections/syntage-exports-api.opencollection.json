{
  "opencollection": "1.0.0",
  "info": {
    "name": "Syntage Accounts Payable Insight Exports API",
    "version": "2020-06-28"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Exports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Export data",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.syntage.com/exports",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an export from a supported collection URI. The export runs asynchronously and returns an Export resource that can be polled until the generated file is ready."
        },
        {
          "info": {
            "name": "Retrieve an export",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.syntage.com/exports/:id",
            "params": [
              {
                "name": "id",
                "value": "91106968-1abd-4d64-85c1-4e73d96fb997",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an export and its current processing status. When the export is finished, the response includes the generated file metadata."
        }
      ]
    }
  ],
  "bundled": true
}